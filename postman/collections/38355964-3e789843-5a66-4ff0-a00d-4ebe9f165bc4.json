		"name": "Marks",
		"description": "# Схема таблиц в БД\n\n``` sql\nCREATE TABLE regular_marks (\n      number integer,\n      value double precision,\n      semester_marks_id_st bigint NOT NULL,\n      semester_marks_id_student bigint NOT NULL,\n      type_mark_id bigint REFERENCES type_mark,\n      date date,\n      homework varchar(255),\n      FOREIGN KEY (semester_marks_id_st, semester_marks_id_student)\n      REFERENCES semester_marks\n);\nCREATE TABLE semester_marks\n (\n      certification double precision,\n      id_st bigint NOT NULL REFERENCES subject_teacher,\n      id_student bigint NOT NULL REFERENCES students,\n      PRIMARY KEY (id_st, id_student)\n);\nCREATE TABLE type_mark\n (\n      id bigint GENERATED BY DEFAULT AS IDENTITY\n PRIMARY KEY,\n      weight bigint,\n      name varchar(255),\n      id_st bigint REFERENCES subject_teacher\n);\n\n ```\n\n## regular_marks\n\nnumber - int, порядковый номер оценки у студента\n\nvalue - int, значение самой оценки\n\nsemester_marks_id_st - int, id subject_teacher\n\nsemester_marks_id_student - int, id студента\n\ntype_mark_id - int, внешний ключ на таблицу type_mark\n\ndate - date, дата оценки\n\nhomework - string, домашнее задание (пока оно привязано к оценки, потом будет привязано к паре)\n\n## semester_marks\n\nsertification - int, оценка за экзамен, дифференцированный зачёт, зачет (надо подумать над типом)\n\nid_st - int, id subject_teacher\n\nid_student - int, id студента\n\n## type_mark\n\nid - int, id вида оценки\n\nweight - int, вес оценки\n\nname - string, название вида оценки\n\nid_st - int, id subject_teacher",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
